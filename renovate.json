{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "gitAuthor": "shakenfist-bot <bot@shakenfist.com>",
  "dependencyDashboard": true,
  "assignees": [
    "mikalstill"
  ],
  "schedule": [
    "after 9pm"
  ],
  "packageRules": [
    {
      "description": "Automatically merge minor and patch-level updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": false
    },
    {
      "description": "Pin aes to 0.8.x: xts-mode 0.5.1 is unmaintained and requires aes 0.8 / cipher 0.4. Re-enable when xts-mode supports cipher 0.5 or we replace it.",
      "matchPackageNames": [
        "aes"
      ],
      "allowedVersions": "<0.9"
    }
  ],
  "minimumReleaseAge": "3 days",
  "rollbackPrs": true
}
