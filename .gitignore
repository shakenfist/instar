# Rust build artifacts
**/target/
**/*.bin
**/Cargo.lock

# Cargo cache for docker builds
.cargo-cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store

# Planning drafts dropped at the repo root are local-only. Tracked
# plans live in docs/plans/ (this rule is anchored to the repo
# root so it does not catch docs/plans/PLAN-*.md).
/PLAN-*.md
