{
    "name": "Instar",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "runArgs": [
        "--device=/dev/kvm",
        "--group-add=kvm"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer"
            ],
            "settings": {
                "rust-analyzer.cargo.target": "x86_64-unknown-none",
                "rust-analyzer.check.allTargets": false
            }
        }
    },
    "postCreateCommand": "rustup show && cargo --version && protoc --version",
    "remoteUser": "vscode"
}
