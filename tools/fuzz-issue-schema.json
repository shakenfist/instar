{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fuzzer Issue Body",
  "description": "Structured issue body for security-audit issues filed by instar fuzzers",
  "type": "object",
  "required": ["source", "target", "signature", "reproducer"],
  "properties": {
    "source": {
      "type": "string",
      "enum": ["coverage-fuzz", "differential-fuzz"],
      "description": "Which fuzzer filed this issue"
    },
    "target": {
      "type": "string",
      "description": "Fuzz target name (e.g. fuzz_qcow2_header)"
    },
    "signature": {
      "type": "string",
      "maxLength": 200,
      "description": "Crash signature (panic message or signal)"
    },
    "reproducer": {
      "type": "string",
      "maxLength": 500,
      "description": "Command to reproduce the crash"
    },
    "crash_input_size": {
      "type": "string",
      "description": "Size of the minimised crash input"
    },
    "log_excerpt": {
      "type": "string",
      "maxLength": 5000,
      "description": "Last N lines of fuzzer log output"
    },
    "ci_run": {
      "type": "string",
      "description": "URL to the CI workflow run"
    }
  },
  "additionalProperties": false
}
